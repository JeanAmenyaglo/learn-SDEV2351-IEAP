@page "/form/step2"
@using Fluxor
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<FormState> FormState
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation

<h3>Form Wizard -- Step 2 of 3</h3>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Contact Details</h5>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" placeholder="Enter your email" />
        </div>

        <button class="btn btn-primary" @onclick="CompleteAndNext">
            Next: Step 3
        </button>
    </div>
</div>

<div class="mt-3 text-muted">
    Completed steps: @string.Join(", ", FormState.Value.CompletedSteps.Order())
</div>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (!FormState.Value.CompletedSteps.Contains(1))
        {
            Navigation.NavigateTo("/form/step1");
            return;
        }
    }

    private void CompleteAndNext()
    {
        Dispatcher.Dispatch(new CompleteStepAction(2));
        Navigation.NavigateTo("/form/step3");
    }
}
